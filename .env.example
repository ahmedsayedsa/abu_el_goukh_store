# ==============================================================================
# أبو الجوخ 1925 - ملف متغيرات البيئة السرية المطلوب إعدادها على Vercel
# IMPORTANT: DO NOT commit actual secrets to GitHub. Set these in Vercel Dashboard:
# Project Settings -> Environment Variables -> Production & Preview
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. لوحة تحكم الأدمن والتوثيق (Admin Dashboard Authentication)
# ------------------------------------------------------------------------------
# اسم مستخدم لوحة التحكم (مثال: admin_goukh)
ADMIN_USERNAME=your_admin_username_here

# كلمة مرور معقدة وقوية (لا تقل عن 14 حرفاً وأرقام ورموز)
ADMIN_PASSWORD=your_strong_admin_password_here

# مفتاح سري عشوائي طويل لتوقيع توكنات JWT المشفرة (64 حرفاً عشوائياً)
ADMIN_JWT_SECRET=generate_a_random_64_character_hex_secret_here

# ------------------------------------------------------------------------------
# 2. قاعدة بيانات Firebase Realtime Database
# ------------------------------------------------------------------------------
# رابط قاعدة بيانات Firebase الرسمية
FIREBASE_DATABASE_URL=https://abu-el-goukh-store-default-rtdb.firebaseio.com

# مفتاح الدخول السري لقاعدة بيانات Firebase (Database Secret أو Service Account Token)
# يمنح دوال الـ API على Vercel صلاحيات القراءة والكتابة بينما يمنع المتصفحات
FIREBASE_AUTH_SECRET=your_firebase_database_secret_here

# ------------------------------------------------------------------------------
# 3. بوابة دفع Paymob (مصر)
# ------------------------------------------------------------------------------
PAYMOB_API_KEY=your_paymob_api_key_here
PAYMOB_SECRET_KEY=your_paymob_secret_key_here
PAYMOB_PUBLIC_KEY=your_paymob_public_key_here
PAYMOB_INTEGRATION_ID=your_paymob_integration_id_here
PAYMOB_IFRAME_ID=your_paymob_iframe_id_here
# مفتاح HMAC لحساب التوقيع والتحقق من الـ Webhook
PAYMOB_HMAC_SECRET=your_paymob_hmac_secret_here

# ------------------------------------------------------------------------------
# 4. بوابة دفع PayTabs (مصر)
# ------------------------------------------------------------------------------
# مفتاح السيرفر السري (يبدأ عادة بـ SHJN...)
PAYTABS_SERVER_KEY=your_paytabs_server_key_here
# رقم البروفايل الخاص بحساب التاجر في PayTabs
PAYTABS_PROFILE_ID=your_paytabs_profile_id_here

# ------------------------------------------------------------------------------
# 5. بوابة دفع فوري باي (FawryPay)
# ------------------------------------------------------------------------------
FAWRY_MERCHANT_CODE=your_fawry_merchant_code_here
FAWRY_SECURITY_KEY=your_fawry_security_key_here
# الوضع: live للإنتاج الحقيقي، أو sandbox للاختبار
FAWRY_MODE=live
